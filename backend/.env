POSTGRES_USER=admin
POSTGRES_PASSWORD=atik@120
POSTGRES_DB=kanban

# PostgreSQL connection string used by Prisma.
# Local (non-Docker) dev: postgresql://postgres:postgres@localhost:5432/kanban
# Docker Compose:         postgresql://postgres:postgres@postgres:5432/kanban
DATABASE_URL=postgresql://admin:atik@120@localhost:5432/kanban

# HTTP port the Nest server listens on.
PORT=4000

# Secret used to sign JWT access tokens — use a long random string in production.
JWT_SECRET=7fKx9mQ2vL8rT4zN6pYw3cD5hJ1sA9eG4uB8nX6qR2tV7mK5
# Access token lifetime (any `ms` package format, e.g. 15m, 1h, 7d).
JWT_EXPIRES_IN=7d

# Origin allowed to call this API (the frontend's URL), for CORS.
CORS_ORIGIN=http://localhost:3000
